# Copy to .env and fill in real values. .env is git-ignored; this template is committed.

# --- LLM providers ---
# Google Gemini (primary) — chat generation + embeddings.
GEMINI_API_KEY=your-gemini-api-key-here

# DeepSeek via NVIDIA's OpenAI-compatible API (fallback).
NVIDIA_API_KEY=your-nvidia-api-key-here

# Mistral via its OpenAI-compatible API (fallback).
MISTRAL_API_KEY=your-mistral-api-key-here

# Optional: OpenAI (only if you have a key; not required).
# OPENAI_API_KEY=your-openai-api-key-here

# Optional: Anthropic (only if you have a key; not required).
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Chat provider routing: auto | gemini | mistral | deepseek | openai
LLM_PROVIDER=auto

# Optional model overrides (defaults shown):
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# MISTRAL_CHAT_MODEL=mistral-small-latest
# MISTRAL_EMBED_MODEL=mistral-embed
# DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-flash   # v4-pro also available but much slower

# Embedding provider routing: auto | gemini | mistral | openai | hash
# Use hash temporarily when paid embedding quota is exhausted.
# EMBED_PROVIDER=auto

# --- App ---
# Runtime environment: "dev" stays bootable with zero secrets (keyless demo).
# Any other value (e.g. "prod") fails fast when APP_SECRET / ADMIN_API_KEY are
# missing and refuses insecure admin access.
ENV=dev

# Used as the key-derivation seed for encrypting channel secrets at rest.
# REQUIRED in non-dev environments. Set a long random value in production.
APP_SECRET=change-me

# --- Admin access (no full login yet — see backend/core/security.py) ---
# Shared secret guarding every /api/admin/* route. Presented by the admin
# console as `Authorization: Bearer <key>` or the `X-Admin-Key` header.
# REQUIRED in non-dev environments.
ADMIN_API_KEY=
# Dev-only escape hatch: when ADMIN_API_KEY is empty AND ENV=dev, set this to 1
# to leave admin routes unauthenticated (keyless demo). Never enable in prod.
ALLOW_INSECURE_ADMIN=0

# SQLite by default; override with any SQLAlchemy URL.
DATABASE_URL=sqlite:///./backend.db

# ChromaDB persistent store location.
CHROMA_DIR=./chroma_store

# CORS origins allowed to call the API (the Next.js frontend).
# Must be explicit origins — '*' is rejected at startup (credentials are enabled).
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
