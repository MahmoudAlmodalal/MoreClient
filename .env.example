# Copy to .env and fill in real values. .env is git-ignored; this template is committed.

# --- LLM providers ---
# Google Gemini (primary) — chat generation + embeddings.
GEMINI_API_KEY=your-gemini-api-key-here

# DeepSeek via NVIDIA's OpenAI-compatible API (fallback).
NVIDIA_API_KEY=your-nvidia-api-key-here

# Optional: OpenAI (only if you have a key; not required).
# OPENAI_API_KEY=your-openai-api-key-here

# Optional: Anthropic (only if you have a key; not required).
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Chat provider routing: auto | gemini | deepseek | openai
LLM_PROVIDER=auto

# Optional model overrides (defaults shown):
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-flash   # v4-pro also available but much slower

# --- App ---
APP_SECRET=change-me

# SQLite by default; override with any SQLAlchemy URL.
DATABASE_URL=sqlite:///./backend.db

# ChromaDB persistent store location.
CHROMA_DIR=./chroma_store

# CORS origins allowed to call the API (the Next.js frontend).
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
