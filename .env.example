# Copy to .env and fill in real values. .env is git-ignored; this template is committed.

# --- LLM providers ---
# Google Gemini (primary) — chat generation + embeddings.
GEMINI_API_KEY=your-gemini-api-key-here

# DeepSeek via NVIDIA's OpenAI-compatible API (fallback).
NVIDIA_API_KEY=your-nvidia-api-key-here

# Mistral via its OpenAI-compatible API (fallback).
MISTRAL_API_KEY=your-mistral-api-key-here

# Optional: OpenAI (only if you have a key; not required).
# OPENAI_API_KEY=your-openai-api-key-here

# Chat provider routing: auto | gemini | mistral | deepseek | openai
LLM_PROVIDER=auto

# Optional model overrides (defaults shown):
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# MISTRAL_CHAT_MODEL=mistral-small-latest
# MISTRAL_EMBED_MODEL=mistral-embed
# DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-flash   # v4-pro also available but much slower

# Embedding provider routing: auto | gemini | mistral | openai | hash
# Use hash temporarily when paid embedding quota is exhausted.
# EMBED_PROVIDER=auto

# --- App ---
APP_SECRET=change-me
